pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_DEFAULT_REGION    = 'eu-central-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('vpc') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Plan Destroy') {
            steps {
                dir('vpc') {
                    sh 'terraform plan -destroy -out=tfdestroyplan'
                }
            }
        }

        stage('Manual Approval - DESTROY') {
            steps {
                input message: 'WARNING: This will DESTROY real infrastructure. Review the destroy plan above. Proceed?', ok: 'Destroy'
            }
        }

        stage('Terraform Destroy') {
            steps {
                dir('vpc') {
                    sh 'terraform apply -auto-approve tfdestroyplan'
                }
            }
        }
    }

    post {
        success {
            echo 'Terraform destroy completed.'
        }
        failure {
            echo 'Destroy pipeline failed. Check the stage logs above.'
        }
    }
}
